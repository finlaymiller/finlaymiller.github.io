---
layout: layouts/base.njk
---
<article class="article">
  <header class="article-header">
    <p class="eyebrow">{{ series or "Writing" }}</p>
    <h1>{{ title }}</h1>
    <p class="article-meta">
      <time datetime="{{ date | isoDate }}">{{ date | readableDate }}</time>
      {% if excerpt %}<span aria-hidden="true"> · </span>{{ excerpt }}{% endif %}
    </p>
  </header>
  <div class="article-body">
    {{ content | safe }}
  </div>
  <p class="article-back"><a href="/writing/">← All writing</a></p>
</article>
