---
layout: layouts/base.njk
title:
description: Personal projects, experiments, and technical notes by Finlay Miller.
---
<section class="intro">
  <h1>Finlay Miller</h1>
  <p>
    I use this site to collect personal projects, experiments, and notes from
    self-directed study in machine learning and music technology.
  </p>
  <p class="contact-line">
    <a href="mailto:{{ site.email }}">Email</a>
    <span aria-hidden="true">/</span>
    <a href="{{ site.github }}">GitHub</a>
  </p>
</section>

<section aria-labelledby="projects-heading">
  <h2 id="projects-heading">Projects</h2>
  <div class="item-list">
    <article class="list-item">
      <div class="item-date">Template</div>
      <div>
        <h3><a href="/projects/example-project/">Academic project microsite</a></h3>
        <p>A self-contained, media-ready page scaffold for a paper or research project.</p>
      </div>
    </article>
  </div>
  <p><a href="/projects/">All projects →</a></p>
</section>

<section aria-labelledby="writing-heading">
  <h2 id="writing-heading">Recent writing</h2>
  <div class="item-list">
    {% for post in collections.writing | head(5) %}
      <article class="list-item">
        <time class="item-date" datetime="{{ post.date | isoDate }}">{{ post.date | monthYear }}</time>
        <div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
  <p><a href="/writing/">All writing →</a></p>
</section>
