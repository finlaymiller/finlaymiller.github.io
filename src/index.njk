<section aria-labelledby="writing-heading">
  <h2 id="writing-heading"><del>Recent w</del>Writing</h2>
  <div class="item-list">
    {% for post in collections.writing | head(5) %}
      <article class="list-item">
        <time class="item-date" datetime="{{ post.date | isoDate }}">{{ post.date | monthYear }}</time>
        <div>
          <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
          {% if post.data.excerpt %}<p>{{ post.data.excerpt }}</p>{% endif %}
        </div>
      </article>
    {% endfor %}
  </div>
